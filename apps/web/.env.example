# Copy to .env.local and fill in values. Next.js loads env files from apps/web only.

# App — /api/apply (email logos), /api/users/create (AutoCare login link)
SITE_URL=http://localhost:3000

# MongoDB — lib/mongodb.js. Fallbacks: MONGODB_URI, DATABASE_URL
MONGO_DB_URL=
# MONGODB_URI=
# DATABASE_URL=

# SMTP — shared. Mailers use secure:true, so port 465 not 587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# School admissions — lib/mailer.js, /api/apply
EMAIL_USER=
EMAIL_PASS=

# AutoCare — /api/autocare/book, /api/users/create
AUTOCARE_EMAIL_USER=
AUTOCARE_EMAIL_PASS=

# Instructor — /api/instructor-application; fallback for job apps
INSTRUCTOR_EMAIL_USER=
INSTRUCTOR_EMAIL_PASS=

# Job apps — /api/job-application. Falls back to INSTRUCTOR_EMAIL_* if unset
TRAINING_EMAIL_USER=
TRAINING_EMAIL_PASS=
TRAINING_EMAIL_TO=training@glitecast.com

# Jobs admin — /jobs/admin (httpOnly cookie, not Clerk). Set both in Vercel too.
JOB_ADMIN_PASSWORD=
JOB_ADMIN_SECRET=

# Clerk — ClerkProvider in app/layout.js (read by @clerk/nextjs)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
